# Company Dashboard — environment template.
# Copy to .env, fill in, and pass to the container with:  docker run --env-file .env ...
# NEVER commit the real .env.  Keep it mode 600:  chmod 600 .env
# Every source is optional: leave a source's variables blank to disable it.

# --- Company / branding ------------------------------------------------
# Shown in the header and browser tab. No company value is baked into the image.
COMPANY_NAME=Acme Inc
COMPANY_SITE_URL=https://example.com
# Optional: URL or path to a logo served by the dashboard.
COMPANY_LOGO_URL=
# Optional: Material 3 accent color (default #0b57d0).
COMPANY_THEME_ACCENT=#0b57d0

# --- App ---------------------------------------------------------------
PORT=8080
NODE_ENV=production
# Required: signs session cookies. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# --- Login (Google OAuth) ---------------------------------------------
# Restricts dashboard access to approved accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://dashboard.example.com/auth/google/callback
# Comma-separated emails allowed to sign in and administer the instance.
ADMIN_EMAILS=you@example.com

# --- Google service account (Search Console, Analytics, AdSense) ------
# One service account can cover all three Google sources; only the scopes
# and the per-property grants differ. Provide the key JSON as base64.
#   base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# --- Google Search Console --------------------------------------------
# Property as it appears in Search Console (e.g. sc-domain:example.com).
GSC_SITE_URL=

# --- Google Analytics 4 -----------------------------------------------
GA4_PROPERTY_ID=

# --- Google AdSense ----------------------------------------------------
ADSENSE_ACCOUNT_ID=

# --- Simple Analytics --------------------------------------------------
SIMPLE_ANALYTICS_SITE=
SIMPLE_ANALYTICS_API_KEY=

# --- Azure (Foundry / Cost Management) --------------------------------
# A service principal with Cognitive Services Reader on the AI resources
# and Cost Management Reader at subscription scope.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
# Comma-separated resource IDs to report AI usage for.
AZURE_RESOURCE_IDS=
# Optional: day of month your Azure billing period rolls over (1-28; default 1).
AZURE_BILLING_DAY_OF_MONTH=1

# --- OpenRouter --------------------------------------------------------
# A regular inference key enables per-key usage.
OPENROUTER_API_KEY=
# A management key additionally enables account balance and 30-day per-model activity.
OPENROUTER_MANAGEMENT_KEY=

# --- Advanced ----------------------------------------------------------
# Optional explicit source toggles (default: a source is enabled when its
# credentials/IDs are present). Comma-separated, e.g. azure,gsc,ga4.
# SOURCES_ENABLED=
# Optional config-file override (mounted into the container). Env vars win when both set.
# COMPANY_CONFIG_PATH=/app/config/company.json