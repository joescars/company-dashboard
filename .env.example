# Company Dashboard — environment template.
# Copy to .env and fill in. NEVER commit the real .env.
# Every source is optional: leave a source's variables blank to disable it.
# Keep this file mode 600 after filling it in:  chmod 600 .env

# --- App ---------------------------------------------------------------
PORT=8080
NODE_ENV=production
# Required: signs session cookies. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# --- Login (Google OAuth) ---------------------------------------------
# Restricts dashboard access to approved accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://dashboard.example.com/auth/google/callback
# Comma-separated emails allowed to sign in and administer the instance.
ADMIN_EMAILS=you@example.com

# --- Google service account (Search Console, Analytics, AdSense) ------
# One service account can cover all three Google sources; only the scopes
# and the per-property grants differ. Provide the key JSON as base64.
#   base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# --- Azure (Foundry / Cost Management) --------------------------------
# A service principal with Cognitive Services Reader on the AI resources
# and Cost Management Reader at subscription scope.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
# Comma-separated resource IDs to report AI usage for; also settable in company.json.
AZURE_RESOURCE_IDS=
# Optional: day of month your Azure billing period rolls over (1-28; default 1).
AZURE_BILLING_DAY_OF_MONTH=1

# --- OpenRouter --------------------------------------------------------
# A regular inference key enables per-key usage.
OPENROUTER_API_KEY=
# A management key additionally enables account balance and 30-day per-model activity.
OPENROUTER_MANAGEMENT_KEY=

# --- Simple Analytics --------------------------------------------------
SIMPLE_ANALYTICS_API_KEY=

# --- Optional ----------------------------------------------------------
# Path to the company config file (default: config/company.json).
# COMPANY_CONFIG_PATH=config/company.json