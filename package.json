{
  "name": "company-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, config-driven dashboard for web traffic, search rank, ad revenue and AI spend.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspace web",
    "start": "node server/index.js",
    "test": "node --test \"server/test/**/*.test.js\"",
    "typecheck": "npm run typecheck --workspace web",
    "dev:server": "node --watch server/index.js",
    "dev:web": "npm run dev --workspace web"
  }
}